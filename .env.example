# --- API ---
PORT=3002
# Leave DATABASE_URL empty to use embedded Postgres (PGlite) stored in PGLITE_DIR.
# Set it for real Postgres (docker-compose / AWS RDS), e.g.:
# DATABASE_URL=postgres://sierra:sierra@localhost:54330/sierra
DATABASE_URL=
PGLITE_DIR=./.data/pg

# Storage: "fs" (local disk) or "s3" (MinIO from docker-compose / AWS S3)
STORAGE_DRIVER=fs
FS_STORAGE_DIR=./.data/files
S3_BUCKET=sierra-files
S3_REGION=eu-central-1
S3_ENDPOINT=http://localhost:9110
S3_ACCESS_KEY_ID=sierra
S3_SECRET_ACCESS_KEY=sierra-secret
S3_FORCE_PATH_STYLE=true

# Public base URL (used to build invitation links)
PUBLIC_URL=http://localhost:5174

# Set to "false" to disable public sign-up (new farms can then only be created by seeding).
ALLOW_SIGNUP=true
